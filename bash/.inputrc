# system defaults (fedora)
set meta-flag on
set input-meta on
set convert-meta off
set output-meta on
set mark-symlinked-directories on

# use vi-mode for readline
set editing-mode vi

# different cursor for ins/cmd mode
set show-mode-in-prompt on
set vi-ins-mode-string "\1\e[5 q\2"
set vi-cmd-mode-string "\1\e[1 q\2"
set keyseq-timeout 0

# add vi ins-mode bindings
set keymap vi-insert
"\C-l": clear-screen

# add vi cmd-mode bindings
set keymap vi-command
"diw": "lbde"
"ciw": "lbce"
"yiw": "lbye"

"diW": "lBdE"
"ciW": "lBcE"
"yiW": "lByE"

"daw": "lbdw"
"caw": "lbdwi"
"yaw": "lbyw"

"daW": "lBdW"
"caW": "lBdWi"
"yaW": "lByW"

"_": "0"
"g_": "$"

"ge": "lbbe"
"gE": "lBbe"

"gg": beginning-of-history
"G": end-of-history
